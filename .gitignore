# Voxylis — ignore rules (deduplicated; every entry is unique)

# Virtual environment
venv/
env/
ENV/
.venv

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
# voxylis.spec is tracked on purpose -- CI builds the EXE from it.

# Root-local build output (anchored; web/downloads/, if it ever returns,
# is website content and stays tracked)
/downloads/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
.directory

# Logs
logs/
*.log

# Temporary files
temp/
tmp/
*.tmp
*.bak

# ---------------------------------------------------------------------------
# Secrets -- must never be committed
#
# Real secrets live in environment variables (server) and the OS credential
# store (desktop). .env.example is the only environment file in the repo and
# it contains variable NAMES with no usable values.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
*.crt
*.der
*.jks
*.keystore
credentials/
secrets/
vault/
runtime/
sessions/
sentry.properties
.sentryclirc

# User data / local databases (never committed)
config/settings.json
config/settings.json.local
config/onboarding.json
config/sessions.json
config/users.json
web/config/*.json
web/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.vault

# Testing
.pytest_cache/
.coverage
htmlcov/

# Audio files (temporary)
*.wav
*.mp3
*.flac

# Deployment / local-tooling artifacts
.vercel
.freebuff/
.playwright-mcp/
screenshots/
landing-verify.png

# Release bundles (hosted on the release page / B2, not in git)
*.zip

# Installer build output
installer/output/
installer/*.exe
