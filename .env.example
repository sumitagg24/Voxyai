# ============================================
# VOXYLIS - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# API KEYS
# ============================================

# OpenAI API Key (for Q&A and enhancement)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (for fast transcription)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# APPLICATION SETTINGS
# ============================================

# Flask environment (development or production)
FLASK_ENV=production

# Flask debug mode (True or False)
FLASK_DEBUG=False

# Application port
PORT=5000

# Application host
HOST=127.0.0.1

# ============================================
# VOXYLIS SETTINGS
# ============================================

# Default language (en, es, fr, de, etc.)
DEFAULT_LANGUAGE=en

# Default enhancement mode (formal, casual, technical, concise, creative)
DEFAULT_ENHANCEMENT=formal

# Default wake word
DEFAULT_WAKE_WORD=Voxy

# Wake word sensitivity (0.0 to 1.0)
WAKE_WORD_SENSITIVITY=0.7

# ============================================
# SUBSCRIPTION SETTINGS
# ============================================

# Stripe API Key (for payments)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=your_stripe_api_key_here

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ============================================
# LOGGING
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/voxylis.log

# ============================================
# FEATURES
# ============================================

# Enable Q&A feature (True or False)
ENABLE_QA=True

# Enable wake word detection (True or False)
ENABLE_WAKE_WORD=True

# Enable custom hotkeys (True or False)
ENABLE_HOTKEYS=True

# Enable cloud sync (True or False)
ENABLE_CLOUD_SYNC=False

# ============================================
# SECURITY
# ============================================

# Secret key for session management
SECRET_KEY=your_secret_key_here_change_in_production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# ============================================
# DATABASE (Optional)
# ============================================

# Database URL (if using database)
# DATABASE_URL=sqlite:///voxylis.db

# ============================================
# NOTES
# ============================================
# 1. Copy this file to .env
# 2. Fill in your API keys
# 3. Never commit .env to version control
# 4. Keep your API keys private
# 5. Change SECRET_KEY in production
