# ============================================================================
# Voxylis — environment configuration reference
# ============================================================================
# Copy to `.env` (local only — `.env` is gitignored) and fill in your values.
#
#   * This file contains NAMES ONLY. No real value may ever be added here.
#   * Every variable below is actually read by code in this repository. If you
#     add a variable here, use it somewhere; if you remove the last use, remove
#     the entry.
#   * Server deployments should set these in the hosting provider's secret
#     store rather than shipping a .env file.
#
# Legend: [SECRET] never commit or log the value. [PUBLIC] safe to expose to a
# browser. [DEFAULT] optional, shown value is what the code already assumes.
# ============================================================================


# ----------------------------------------------------------------------------
# Core / Flask                                          [SECRET where noted]
# ----------------------------------------------------------------------------
# [SECRET] Required in production. >= 32 random chars. The app refuses to start
# in production when this is missing, a placeholder, or too short.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# [DEFAULT] Deployment environment: production | development.
# Any of these names works (first one set wins): VOXYLIS_ENV, APP_ENV,
# FLASK_ENV, ENVIRONMENT. Hosted platforms (Vercel/Render/Fly/Dyno) are
# auto-detected as production even when unset.
VOXYLIS_ENV=

# [DEFAULT] Port the WSGI server binds to. 5000
PORT=

# [DEFAULT] Gunicorn worker count. Defaults to cpu_count * 2 + 1.
GUNICORN_WORKERS=

# [DEFAULT] Gunicorn log level: debug | info | warning | error
LOG_LEVEL=

# [DEFAULT] Comma-separated origins allowed to call the API with CORS.
# Defaults to the voxylis.com origins, the Vercel preview host and localhost.
CORS_ORIGINS=

# [SECRET] Path to the SQLite file. Defaults to web/data/voxylis.db (gitignored).
# Never point this at a file inside the repository.
VOXYLIS_DB_PATH=


# ----------------------------------------------------------------------------
# Roles and quotas                                      [SERVER-SIDE ONLY]
# ----------------------------------------------------------------------------
# [SECRET-ish] Comma-separated emails that are owners: unlimited usage,
# tier=owner, role=owner. Enforced server-side on every request.
OWNER_EMAILS=

# Comma-separated emails with full feature access (admins).
ADMIN_EMAILS=

# Comma-separated domains allowed to sign up with a password.
# Auth0 social sign-in bypasses this list.
PASSWORD_LOGIN_DOMAINS=

# [DEFAULT] Monthly transcription quotas per tier (-1 = unlimited).
FREE_MONTHLY_TRANSCRIPTIONS=100
PRO_MONTHLY_TRANSCRIPTIONS=1000
BUSINESS_MONTHLY_TRANSCRIPTIONS=5000

# [DANGER] Development-only override that lets an authenticated non-admin change
# their own tier. Ignored whenever the app runs in production. Leave unset.
ALLOW_DEV_TIER_CHANGE=


# ----------------------------------------------------------------------------
# Speech-to-text / AI provider keys used by the SERVER
#
# None of these are bundled with the desktop app: each install supplies its own
# key, stored in the OS credential store (Windows DPAPI / Keychain / Secret
# Service) and never in a settings file.
# ----------------------------------------------------------------------------
# [SECRET] Muse Voice Transcribe (primary STT).
MODEL_API_KEY=
# [SECRET] Groq (STT fallback + Q&A/enhancement).
GROQ_API_KEY=
# [SECRET] OpenAI (final fallback).
OPENAI_API_KEY=
# [SECRET] OpenRouter (optional, stored by desktop clients only).
OPENROUTER_API_KEY=


# ----------------------------------------------------------------------------
# Authentication (Auth0 — optional social login + desktop device flow)
# ----------------------------------------------------------------------------
# Tenant domain without the scheme, e.g. voxylis.us.auth0.com
AUTH0_DOMAIN=
# [PUBLIC] Single-page-app client id (PKCE, no secret).
AUTH0_CLIENT_ID=
# [PUBLIC] Native-app client id for the desktop device flow. Falls back to
# AUTH0_CLIENT_ID when empty.
AUTH0_DESKTOP_CLIENT_ID=


# ----------------------------------------------------------------------------
# Email (transactional) — see docs/DEPLOYMENT.md § E
# ----------------------------------------------------------------------------
# [DEFAULT] Which adapter to use: resend | smtp | console | auto.
#   auto (default) -> resend when EMAIL_API_KEY is set, else smtp when
#                     SMTP_HOST is set, else console.
# `console` writes messages to the log instead of sending them. It is a
# development aid: in production every verification and reset email is dropped,
# and the app logs a warning on startup. Set a real provider before launch.
EMAIL_PROVIDER=

# [SECRET] API key for the HTTP provider (Resend). Required for EMAIL_PROVIDER=resend.
EMAIL_API_KEY=

# From address, e.g. "Voxylis <hello@voxylis.com>". Must be a verified sender.
EMAIL_FROM=
# Optional Reply-To, e.g. support@voxylis.com
EMAIL_REPLY_TO=
# Inbox that receives contact-form notifications. Defaults to EMAIL_FROM.
SUPPORT_EMAIL=

# SMTP alternative (used when EMAIL_PROVIDER=smtp).
SMTP_HOST=
SMTP_PORT=587
# [SECRET]
SMTP_USERNAME=
SMTP_PASSWORD=
# [DEFAULT] true = STARTTLS on port 587. Set false for implicit TLS on 465.
SMTP_USE_TLS=true

# [PUBLIC] Base URL of the website. All email links are built from this, so it
# must be the real public origin in production (https://voxylis.com).
FRONTEND_URL=
# Optional overrides. When empty, links default to
#   {FRONTEND_URL}/auth?verify_token={token}
#   {FRONTEND_URL}/auth?reset_token={token}
EMAIL_VERIFICATION_URL=
PASSWORD_RESET_URL=


# ----------------------------------------------------------------------------
# Error monitoring (Sentry) — see docs/DEPLOYMENT.md § F
# ----------------------------------------------------------------------------
# [SECRET] Server DSN. Leave empty to disable Sentry entirely; the app runs
# normally without it. Never expose this DSN to browsers.
SENTRY_DSN=
# [PUBLIC] Browser DSN for the website bundle. Sentry browser DSNs are public by
# design. Leave empty to disable browser monitoring. An organization/auth token
# must NEVER be placed in frontend code — it is only needed for release uploads
# in CI (SENTRY_AUTH_TOKEN, see .github/workflows/release.yml).
SENTRY_DSN_BROWSER=
# [DEFAULT] Environment tag. Defaults to the resolved deployment environment.
SENTRY_ENVIRONMENT=
# [DEFAULT] Release tag. Defaults to the canonical app version (v{version}).
SENTRY_RELEASE=
# [DEFAULT] Performance-tracing sample rate, 0.0–1.0. Defaults to 0.05 in
# production and 1.0 in development.
SENTRY_TRACES_SAMPLE_RATE=


# ----------------------------------------------------------------------------
# Downloads / releases (see docs/RELEASE.md)
# ----------------------------------------------------------------------------
# Absolute URL of the published installer. When empty the site does NOT link to
# a download file: it points at the releases page instead, because advertising
# an artifact that was never published is a 404 for every visitor. Set these
# only after the matching release exists.
DOWNLOAD_URL_WINDOWS=
DOWNLOAD_URL_MACOS=
DOWNLOAD_URL_LINUX=


# ----------------------------------------------------------------------------
# Payments — NOT IMPLEMENTED (see docs/DEPLOYMENT.md § H)
# ----------------------------------------------------------------------------
# No payment provider is wired up. Paid plans cannot be purchased and the site
# says so. The single value the backend reads is the webhook secret used to
# reject unverified tier changes; when it is empty every paid tier change is
# refused with `payments_not_configured`.
STRIPE_WEBHOOK_SECRET=


# ----------------------------------------------------------------------------
# Desktop application (client-side)
# ----------------------------------------------------------------------------
# Overrides the user-data root. Defaults to %LOCALAPPDATA%\Voxylis on Windows,
# ~/Library/Application Support/Voxylis on macOS,
# $XDG_DATA_HOME/voxylis on Linux.
VOXYLIS_HOME=
# Desktop crash reporting (see docs/DEPLOYMENT.md § F). The PyInstaller build
# never contains a DSN. On an installed machine set SENTRY_DSN_FILE to the
# absolute path of a file containing the DSN, or export SENTRY_DSN directly for
# CI/dev runs. Reports only ever leave the machine after the user opts in via
# Settings → Privacy → Send crash reports.
SENTRY_DSN_FILE=
# Signed release feed for the desktop updater (JSON manifest).
VOXYLIS_UPDATE_FEED=
# [SECRET] Optional token for the update feed host / GitHub API.
GITHUB_TOKEN=
